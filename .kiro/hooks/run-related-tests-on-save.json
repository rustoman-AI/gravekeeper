{
    "version":  "v1",
    "hooks":  [
                  {
                      "name":  "Run related tests on save",
                      "description":  "After saving a .ts file under core/ or tests/core/, run the Vitest files related to it (a test file runs itself) and report failures.",
                      "trigger":  "PostFileSave",
                      "matcher":  "(^|[\\\\/])(core|tests[\\\\/]core)[\\\\/].+\\.ts$",
                      "timeout":  180,
                      "action":  {
                                     "type":  "command",
                                     "command":  "node scripts/hooks/vitest-related.mjs"
                                 }
                  }
              ]
}