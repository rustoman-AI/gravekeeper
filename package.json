{
  "name": "gravekeeper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check:core": "tsx scripts/check-core-purity.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "live:report": "tsx scripts/live-report.ts",
    "check": "npm run check:core && npm run check:architecture",
    "prebuild": "npm run check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest --run",
    "test:deep": "tsx scripts/test-deep.ts"
  },
  "dependencies": {
    "@renovatebot/pep440": "5.0.1",
    "@vercel/functions": "3.11.3",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "7.8.6",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "7.8.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.10.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
