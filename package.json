{
  "name": "gravekeeper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check:core": "tsx scripts/check-core-purity.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "live:report": "tsx scripts/live-report.ts",
    "check:bundle": "tsx scripts/check-client-js-budget.ts",
    "verify:deploy": "tsx scripts/verify-deployment.ts https://gravekeeper-chi.vercel.app",
    "check": "npm run check:core && npm run check:architecture",
    "prebuild": "npm run check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest --run",
    "report:m1": "tsx scripts/write-m1-report.ts",
    "report:m2": "tsx scripts/write-m2-report.ts",
    "report:m3": "tsx scripts/write-m3-report.ts",
    "test:deep": "tsx scripts/test-deep.ts",
    "e2e:fixtures": "tsx scripts/export-scan-fixtures.ts",
    "test:e2e": "npm run e2e:fixtures && playwright test"
  },
  "dependencies": {
    "@renovatebot/pep440": "5.0.1",
    "@vercel/functions": "3.11.3",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "7.8.6",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.10.2",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
